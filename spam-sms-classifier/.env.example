# SpamGuard Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Database Driver: 'mysql' for MySQL server, or 'sqlite' for zero-config fallback
SPAM_DB_DRIVER=mysql

# MySQL Connection Details
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=spamguard_db

# Flask Application Settings
FLASK_SECRET_KEY=spamguard-secret-key-change-this-in-production
PORT=5000
